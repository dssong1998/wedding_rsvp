{
  "name": "layout",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "format": "echo \"layout format skipped\"",
    "preview": "vite preview",
    "catalog:tiles": "node scripts/build-base-tile-catalog.mjs",
    "backgrounds:build": "python3 scripts/build-venue-backgrounds.py",
    "presets:bake": "pnpm exec tsx scripts/bake-presets.ts",
    "presets:import": "pnpm exec tsx scripts/import-preset.ts",
    "audit:copy": "node scripts/audit-client-copy.mjs"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "phaser": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
