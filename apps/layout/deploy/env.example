# scripts/deploy.sh 에서 사용. 이 파일을 deploy/env 로 복사한 뒤 값을 채우세요.
#
# cp deploy/env.example deploy/env

# SSH 접속 (dae-da.com과 동일 서버)
DEPLOY_HOST=your-server.example.com
DEPLOY_USER=deploy
DEPLOY_PORT=22

# 서버 document root (nginx root 와 동일하게)
DEPLOY_PATH=/var/www/layout.dae-da.com

# rsync SSH 옵션 (키 경로 등)
# RSYNC_SSH="ssh -i ~/.ssh/id_ed25519 -p 22"
