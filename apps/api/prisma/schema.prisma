datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Guest {
  id        Int      @id @default(autoincrement())
  seq       Int?
  name      String
  seats     Int      @default(1)
  rsvp      Rsvp?
  createdAt DateTime @default(now())

  @@unique([name])
  @@index([name])
}

model Rsvp {
  id            Int      @id @default(autoincrement())
  guest         Guest    @relation(fields: [guestId], references: [id])
  guestId       Int      @unique
  weddingAttend Boolean
  afterAttend   Boolean
  headcount     Int      @default(1)
  addrZip       String?
  addrRoad      String
  addrDetail    String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model GuestMessage {
  id         Int      @id @default(autoincrement())
  nickname   String
  message    String
  inviteName String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([inviteName])
}

/// Bonelli layout — version name = S3 folder under AWS_S3_LAYOUT_PREFIX.
model LayoutVersion {
  id        Int                    @id @default(autoincrement())
  name      String                 @unique
  s3Prefix  String
  venueId   String?
  label     String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  history   LayoutVersionHistory[]

  @@index([name])
}

/// Each save appends a timestamped JSON snapshot under the version folder.
model LayoutVersionHistory {
  id        Int           @id @default(autoincrement())
  version   LayoutVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId Int
  s3Key     String        @unique
  savedAt   DateTime      @default(now())
  label     String?

  @@index([versionId, savedAt])
}
