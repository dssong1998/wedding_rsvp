API_PORT=4000
DATABASE_URL=postgresql://wedding:password@localhost:5432/wedding
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SESSION_SECRET=change_me
ADMIN_OTP_TTL_MINUTES=10
DISCORD_WEBHOOK_URL=
DISCORD_OTP_WEBHOOK_URL=

# AWS S3 — layout JSON version storage (client presigned PUT)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# 버킷 내 layout JSON 폴더 (예: s3://dae-da/Layout/)
AWS_S3_LAYOUT_PREFIX=Layout
# S3 버킷 CORS: deploy/s3-layout-cors.json 참고
# aws s3api put-bucket-cors --bucket YOUR_BUCKET --cors-configuration file://deploy/s3-layout-cors.json
